{
  "name": "compass",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "app:dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "electron .",
    "app": "vite build && electron .",
    "check": "svelte-check --tsconfig ./tsconfig.json",
