    "@tsconfig/svelte": "^5.0.4",
    "electron": "44.9.3",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "productName": "Compass",
